    "@fortawesome/fontawesome-svg-core": "^1.2.35",
    "@fortawesome/free-regular-svg-icons": "^5.15.3",
    "@fortawesome/free-solid-svg-icons": "^5.15.3",
    "@fortawesome/react-fontawesome": "^0.1.14",
    "@material-ui/core": "^4.11.3",
    "@material-ui/data-grid": "^4.0.0-alpha.22",
    "@material-ui/styles": "^4.11.3",
    "@types/react": "^17.0.3",
    "@types/react-dom": "^17.0.2",
    "axios": "^0.20.0",
    "date-fns": "^2.19.0",
    "framer-motion": "^2.9.5",
    "howler": "^2.2.1",
    "lodash": "^4.17.20",
    "query-string": "^6.14.0",
    "react": "^17.0.1",
    "react-countdown": "^2.3.1",
    "react-dom": "^17.0.1",
    "react-ga": "^3.3.0",
    "react-hook-form": "^6.15.5",
    "react-query": "^3.16.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.3",
    "react-twitter-widgets": "^1.10.0",
    "zustand": "^3.5.1"
  },
  "devDependencies": {
    "@types/howler": "^2.2.2",
    "@types/lodash": "^4.14.168",
    "@types/material-ui": "^0.21.8",
    "@types/node": "^12.20.5",
    "@types/react-router-dom": "^5.1.7",
    "concurrently": "^5.3.0",
    "cross-env": "^7.0.3",
    "typescript": "^4.2.3"
  },
  "scripts": {
    "dev": "concurrently -p name -c \"yellow,blue\" -n \"worker,CRA\" \"npm run dev:worker\" \"npm run dev:client\"",
    "dev:client": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "dev:worker": "npm --prefix worker run dev",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "build:client": "npm run build",
    "deploy": "npm run build && npm --prefix worker run deploy",
    "typecheck:worker": "npm --prefix worker run typecheck",
    "postinstall": "npm --prefix worker install"
  },
  "overrides": {
    "postcss-safe-parser": {
      "postcss": "^8.4.49"
    }
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
