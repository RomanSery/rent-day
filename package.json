{
  "name": "rent-day",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-regular-svg-icons": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@fortawesome/react-fontawesome": "^3.1.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@tanstack/react-query": "^5.90.0",
    "axios": "^1.21.0",
    "framer-motion": "^14.0.0",
    "howler": "^2.2.4",
    "lodash": "^4.18.1",
    "query-string": "^10.0.0",
    "react": "^19.2.0",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-router-dom": "^7.18.5",
    "react-twitter-widgets": "^1.11.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "react-twitter-widgets": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0"
    }
  },
  "scripts": {
    "dev": "concurrently -p name -c \"yellow,blue\" -n \"worker,vite\" \"npm run dev:worker\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:worker": "npm --prefix worker run dev",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "build:client": "npm run build",
    "preview": "vite preview",
    "deploy": "npm run build && npm --prefix worker run deploy",
    "typecheck:worker": "npm --prefix worker run typecheck",
    "postinstall": "npm --prefix worker install"
  }
}
