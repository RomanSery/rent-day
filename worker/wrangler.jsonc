{
  // Cloudflare Workers configuration for the Block Barons backend.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "block-barons",
  "main": "src/index.ts",
  "tsconfig": "tsconfig.json",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Served at blockbarons.coderdreams.com. `wrangler deploy` creates the
  // custom domain (DNS record and certificate) itself; coderdreams.com must
  // be a zone in the same Cloudflare account.
  "routes": [{ "pattern": "blockbarons.coderdreams.com", "custom_domain": true }],

  // The React build (../build) is served as static assets by the same
  // Worker. Only /api/* and /ws reach the Worker script; everything else is
  // served from the build folder with SPA fallback to index.html.
  "assets": {
    "directory": "../build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/ws/*"]
  },

  // One Durable Object per game: holds the game state, auctions, lottos,
  // trades and the players' WebSocket connections.
  "durable_objects": {
    "bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  // D1 holds user accounts and the lobby's list of games.
  // Create it with:  npm run db:create   (inside the worker folder)
  // then paste the returned database_id below and run db:migrate:remote.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "block-barons-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENVIRONMENT": "production",
    // PBKDF2 iterations for password hashing. Lower it if logins hit the
    // free plan's CPU limit.
    "PBKDF2_ITERATIONS": "100000",
    // Hostnames the sign-up page is served from (comma-separated). The
    // Turnstile check refuses tokens solved anywhere else, and sign-up is
    // refused while this is empty. Add the *.workers.dev hostname too if
    // players use it. Never list localhost here.
    // The Turnstile secret key is a secret, not a var:
    //   npx wrangler secret put TURNSTILE_SECRET_KEY
    "TURNSTILE_HOSTNAMES": "blockbarons.coderdreams.com"
  },

  // Per-IP limits on /api/logIn and /api/createAccount (per Cloudflare
  // location, so approximate). A per-email lockout in D1 backs them up.
  // namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SIGNUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "CONTACT_LIMITER", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ],

  // Local dev settings go in worker/.dev.vars (see .dev.vars.example).

  "observability": { "enabled": true }
}
