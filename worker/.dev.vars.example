# Copy to .dev.vars for local development with `npm run dev`.
# .dev.vars is read by wrangler and must not be committed.
ENVIRONMENT=development
PBKDF2_ITERATIONS=100000

# Dev shortcut: the second player starts owning every property
DEV_PREOWN_PROPERTIES=false

# Cloudflare Turnstile (the "verify you are human" check on sign-up).
# This is Turnstile's published test secret that accepts every token; it
# pairs with the test site key in the client's .env.development. In
# production set the real one with `wrangler secret put TURNSTILE_SECRET_KEY`.
# To see sign-up refused, use the always-fail test secret instead:
#   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional in development: hostnames whose tokens are accepted (ignored for
# test-key results)
# TURNSTILE_HOSTNAMES=localhost

# Development only: shorten the timers (seconds) to test timeout flows
# DEV_TURN_SECONDS=6
# DEV_AUCTION_SECONDS=6

# Development only: base delay between computer player actions (ms, default 1600)
# DEV_BOT_PACE_MS=30

# Accounts (comma-separated emails) that can read Contact Us messages on
# /admin/messages. In production set it with `wrangler secret put ADMIN_EMAILS`.
# ADMIN_EMAILS=you@example.com

# Development only: games without a move for this long leave the watch list
# (default 1800), and how often a game records its latest move (default 300)
# DEV_WATCH_IDLE_SECONDS=6
# DEV_ACTIVITY_TOUCH_SECONDS=2

# Development only: the per-IP login/sign-up rate limits are off in
# development (the tests create many accounts); set to true to try them
# DEV_RATE_LIMIT=true
