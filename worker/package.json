{
  "name": "rent-day-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Block Barons backend on Cloudflare Workers, Durable Objects and D1",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../build',{recursive:true})\" && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "db:create": "wrangler d1 create rentday-db",
    "db:migrate:local": "wrangler d1 migrations apply rentday-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rentday-db --remote",
    "secret:jwt": "wrangler secret put JWT_SECRET",
    "tail": "wrangler tail",
    "test:api": "node test/smoke.mjs && node test/chance.mjs",
    "test:api:deep": "node test/deep.mjs",
    "test:api:timers": "node test/timeouts.mjs",
    "test:api:bots": "node test/bots.mjs",
    "sim": "node test/sim.mjs",
    "test:api:rejoin": "node test/rejoin.mjs",
    "test:api:snapshots": "node test/snapshots.mjs",
    "test:api:seeded": "node test/seeded.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "hono": "^4.6.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/lodash": "^4.17.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.40.0"
  }
}
