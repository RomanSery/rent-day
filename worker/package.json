{
  "name": "rent-day-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Rent Day backend on Cloudflare Workers, Durable Objects and D1",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../build',{recursive:true})\" && wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "db:create": "wrangler d1 create rentday-db",
    "db:migrate:local": "wrangler d1 migrations apply rentday-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply rentday-db --remote",
    "secret:jwt": "wrangler secret put JWT_SECRET",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "hono": "^4.6.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/lodash": "^4.17.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.40.0"
  }
}
