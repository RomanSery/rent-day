# Cloudflare Turnstile site key for the sign-up form's "verify you are human"
# check. This is Turnstile's published test key (always passes, no real
# challenge); it pairs with the test secret in worker/.dev.vars.
# Production builds read VITE_TURNSTILE_SITE_KEY from .env.production.local
# or the build environment; see the README's deploy section.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
